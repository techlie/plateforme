# Copier ce fichier en .env et renseigner les valeurs. Le fichier .env n'est jamais enregistré dans le dépôt.
PORT=3000
NODE_ENV=development
# Adresses autorisées à appeler le serveur, séparées par des virgules.
ORIGINES_AUTORISEES=http://localhost:4200
# Mettre true derrière le serveur frontal (IONOS), pour lire la vraie adresse des visiteurs.
CONFIANCE_PROXY=false

# Base PostgreSQL de la plateforme.
DATABASE_URL=postgresql://utilisateur:mot-de-passe@localhost:5432/plateforme
# Base réservée aux tests de bout en bout : son nom doit contenir « test ». Elle est vidée à chaque lancement.
DATABASE_URL_TEST=postgresql://utilisateur:mot-de-passe@localhost:5432/plateforme_test

# Clé qui scelle les codes de connexion : au moins 32 caractères aléatoires, différente par serveur.
# Exemple pour en tirer une : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CLE_SECRETE=

# Adresse publique de l'application, utilisée dans les liens envoyés par courriel.
URL_APPLICATION=http://localhost:4200

# Envoi des courriels. Sans SMTP_HOTE, en développement, les courriels sont écrits dans la console du serveur.
# En production, SMTP_HOTE est obligatoire.
COURRIEL_EXPEDITEUR="SR CONSEIL <ne-pas-repondre@exemple.fr>"
SMTP_HOTE=
SMTP_PORT=587
SMTP_SECURISE=false
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=

# Durée d'une session (heures) et déconnexion après inactivité (minutes).
SESSION_DUREE_HEURES=12
SESSION_INACTIVITE_MINUTES=120
